# ==============================================================================
# RideNow Environment Variables Configuration
# Copy this file to .env or .env.local and update with your actual credentials.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Database
# MongoDB connection URI (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/rydex?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017/rydex

# NextAuth Authentication
# Secret key used to encrypt session tokens (generate using: openssl rand -base64 32)
AUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# Google OAuth (Optional: for Google Single Sign-On)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Razorpay Payment Gateway
# Obtain from Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_yourKeyIdHere

# Realtime WebSocket / Socket.IO Server
# Local development default is http://localhost:5000 or production server URL
NEXT_PUBLIC_SOCKET_SERVER=http://localhost:5000

# Cloudinary (Media storage for KYC documents and vehicle photographs)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ZegoCloud (WebRTC Video KYC for partner onboarding verification)
ZEGO_APP_ID=1234567890
ZEGO_SERVER_SECRET=your_zego_server_secret_here
NEXT_PUBLIC_ZEGO_APP_ID=1234567890

# Resend Email Service (For OTP verification, receipts, and system alerts)
RESEND_API_KEY=re_your_resend_api_key_here

# Meta WhatsApp Cloud API & Baileys Persistent Node.js Service
WHATSAPP_PROVIDER=baileys
WHATSAPP_BAILEYS_URL=http://localhost:5000
WHATSAPP_API_TOKEN=your_meta_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Upstash Redis (Serverless high-speed caching for places, nearby vehicles, and rate limiting)
# Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here


# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@yourdomain.com
